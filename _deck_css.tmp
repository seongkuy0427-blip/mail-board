  /* === PRESENTATION_START (CSS) ==========================================
     📊 발표 모드 — 임원·사내 보고용 16:9 화이트 슬라이드 덱.
     (표지 = 샘플 커버 스타일 / 본문 = 상단 조직·제목 + 3단 카드 + 점선 연결 + 파란 요약 박스)
     보고가 끝나면 이 블록을 HTML·JS의 같은 마커 구간과 함께 통째로 지우면 됩니다.
     ====================================================================== */
  /* 헤더의 📊 발표 버튼 */
  .deck-btn{height:32px; padding:0 11px; border-radius:9px; border:1px solid #c7d9f8;
    background:linear-gradient(180deg,#f5f9ff,#e6effd); color:#1b4c9c; cursor:pointer;
    display:inline-flex; align-items:center; justify-content:center; gap:4px;
    font-size:11.5px; font-weight:800; white-space:nowrap; font-family:inherit;
    box-shadow:inset 0 1px 0 #fff; transition:background .12s, transform .06s, box-shadow .12s}
  .deck-btn:hover{background:linear-gradient(180deg,#ecf4ff,#d9e7fd); box-shadow:0 2px 9px rgba(31,95,208,.2), inset 0 1px 0 #fff}
  .deck-btn:active{transform:scale(.97)}

  /* 무대 — 순백 캔버스 */
  #deck{position:fixed; inset:0; z-index:76; display:none; flex-direction:column; color:#2b2f36;
    background:#f4f7fb}
  #deck.on{display:flex}

  .deck-top{display:flex; align-items:center; gap:10px; padding:10px 22px; flex:none;
    background:rgba(255,255,255,.82); border-bottom:1px solid #e4ebf6}
  .deck-top .dk-mark{width:7px; height:7px; border-radius:999px; background:#5b9bf8; flex:none}
  .deck-top .dk-brand{font-size:11.3px; color:#7d8798; overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
  .deck-top .dk-brand b{color:#2b2f36; font-weight:700}
  .deck-top .dk-close{margin-left:auto; flex:none; height:30px; padding:0 13px; border-radius:8px; cursor:pointer;
    border:1px solid #d6e2f3; background:#fff; color:#3d4a5c; font-size:11.4px; font-weight:600;
    font-family:inherit; white-space:nowrap; transition:background .14s, border-color .14s}
  .deck-top .dk-close:hover{background:#f2f7ff; border-color:#bcd2f2}

  /* 슬라이드 — 16:9 흰 카드 */
  .deck-stage{position:relative; flex:1; min-height:0; padding:16px 24px 4px}
  .slide{position:absolute; inset:0; margin:auto; overflow:hidden;
    width:min(1120px, calc(100vw - 48px), calc((100vh - 188px) * 1.7778));
    aspect-ratio:16/9; max-height:calc(100vh - 188px);
    background:#fff; color:#1a1d23; border:1px solid #e6edf7; border-radius:8px;
    box-shadow:0 16px 40px rgba(30,54,92,.12);
    padding:clamp(16px, 3.4vh, 34px) clamp(22px, 4vw, 54px) clamp(14px, 2.6vh, 26px);
    display:flex; flex-direction:column;
    opacity:0; transform:translateY(10px); pointer-events:none;
    transition:opacity .3s ease, transform .3s ease}
  .slide.on{opacity:1; transform:none; pointer-events:auto; z-index:1}

  /* ---------- 본문 슬라이드 ---------- */
  .sl-head{display:flex; align-items:flex-start; gap:12px; flex:none;
    padding-bottom:10px; border-bottom:1px solid #c5d8f6}
  .sl-org{font-size:10.8px; font-weight:700; color:#4a7fd4; letter-spacing:-.1px; line-height:1.3}
  .sl-title{font-size:clamp(20px, 3.1vh, 30px); font-weight:800; letter-spacing:-1.1px;
    color:#16191f; margin:6px 0 0; line-height:1.18}
  .sl-logo{margin-left:auto; flex:none; width:clamp(34px, 5.6vh, 48px); height:clamp(34px, 5.6vh, 48px);
    display:flex; align-items:center; justify-content:center}
  .sl-logo img{width:100%; height:100%; object-fit:contain; display:block}

  .sl-cards{display:grid; grid-template-columns:repeat(3, 1fr); gap:clamp(14px, 2.2vw, 24px);
    margin-top:auto; padding-top:clamp(14px, 4vh, 40px)}
  .sl-card{background:#fff; border:1px solid #dce3ee; border-radius:12px;
    padding:clamp(12px, 2.2vh, 20px) clamp(13px, 1.5vw, 20px) clamp(12px, 2vh, 18px);
    display:flex; flex-direction:column; min-height:clamp(112px, 19vh, 158px)}
  .sl-card .lbl{font-size:clamp(11px, 1.55vh, 13px); font-weight:800; color:#5b9bf8; letter-spacing:-.1px}
  .sl-card h3{font-size:clamp(13px, 2.1vh, 16.5px); font-weight:800; color:#20242b;
    margin:8px 0 8px; letter-spacing:-.5px; line-height:1.35}
  .sl-card p{font-size:clamp(10.5px, 1.62vh, 12.4px); color:#5a6472; line-height:1.72; margin:0}

  /* 카드 아래 파란 점선 + 점 */
  .sl-links{display:grid; grid-template-columns:repeat(3, 1fr); gap:clamp(14px, 2.2vw, 24px); flex:none}
  .sl-links span{position:relative; width:0; height:clamp(16px, 4vh, 40px);
    margin:0 auto; border-left:2px dotted #4a8df8}
  .sl-links span::after{content:""; position:absolute; left:-5px; bottom:-5px; width:8px; height:8px;
    border-radius:50%; background:#4a8df8}

  /* 파란 요약 박스 */
  .sl-sum{flex:none; margin-top:clamp(10px, 2.4vh, 22px); background:#6fa7fa; border-radius:12px;
    padding:clamp(12px, 2.2vh, 18px) clamp(16px, 2.4vw, 28px);
    display:flex; flex-direction:column; gap:clamp(6px, 1.3vh, 11px); color:#fff}
  .sl-sum div{display:flex; gap:10px; align-items:flex-start;
    font-size:clamp(10.8px, 1.66vh, 12.8px); line-height:1.55}
  .sl-sum div::before{content:""; width:7px; height:7px; border-radius:50%; background:#fff;
    flex:none; margin-top:.42em}
  .sl-sum b{font-weight:800}
  .sl-cta-row{flex:none; display:flex; justify-content:flex-end; margin-top:clamp(8px, 1.6vh, 14px)}
  .sl-cta{display:inline-flex; align-items:center; gap:7px; padding:9px 17px; border-radius:10px; border:none;
    background:#3c82f6; color:#fff; font-size:12.3px; font-weight:800; cursor:pointer; font-family:inherit;
    box-shadow:0 6px 16px rgba(60,130,246,.28); transition:background .14s, transform .08s}
  .sl-cta:hover{background:#2f6fe4}
  .sl-cta:active{transform:scale(.98)}
  .sl-pg{position:absolute; right:clamp(16px, 2.2vw, 26px); bottom:clamp(9px, 1.5vh, 14px);
    font-size:11px; color:#a7b2c2; letter-spacing:.02em}

  /* ---------- 표지 ---------- */
  .cv{align-items:center; text-align:center; padding:0; justify-content:flex-start}
  .cv .cv-title{margin-top:clamp(34px, 15vh, 118px); font-size:clamp(21px, 4.1vh, 46px);
    font-weight:800; letter-spacing:-2px; color:#2b2f36; line-height:1.34; z-index:2}
  .cv .cv-title em{font-style:normal; color:#5b9bf8}
  .cv .cv-sub{margin-top:clamp(10px, 2.6vh, 22px); font-size:clamp(10.5px, 1.62vh, 15px);
    color:#555d6b; z-index:2}
  .cv .cv-wave{position:absolute; left:0; right:0; top:38%; width:100%; height:58%;
    pointer-events:none; z-index:1}
  .cv .cv-logo{position:absolute; left:50%; bottom:clamp(10px, 3.4vh, 26px); transform:translateX(-50%);
    width:clamp(36px, 6.4vh, 58px); height:auto; z-index:2}

  /* 하단 진행 바 + 내비게이션 */
  .deck-progress{flex:none; height:3px; margin:9px 24px 0; border-radius:2px; background:#dde6f4; overflow:hidden}
  .deck-progress i{display:block; height:100%; width:0;
    background:linear-gradient(90deg,#5b9bf8,#9dc3fb); transition:width .34s ease}
  .deck-nav{display:flex; align-items:center; justify-content:center; gap:11px; padding:11px 24px 9px; flex:none; flex-wrap:wrap}
  .dk-nav-btn{height:32px; padding:0 13px; border-radius:8px; border:1px solid #d6e2f3;
    background:#fff; color:#2f3a4b; font-size:11.8px; font-weight:700; cursor:pointer; font-family:inherit;
    transition:background .14s, border-color .14s}
  .dk-nav-btn:hover{background:#f2f7ff; border-color:#bcd2f2}
  .dk-nav-btn:disabled{opacity:.34; cursor:default}
  .dk-dots{display:flex; gap:6px; align-items:center}
  .dk-dot{width:16px; height:4px; border-radius:999px; background:#cbd8ea; cursor:pointer; border:none;
    padding:0; transition:background .2s, width .2s}
  .dk-dot:hover{background:#a9bfdd}
  .dk-dot.on{width:26px; background:#5b9bf8}
  .dk-ind{font-size:11.5px; color:#6b7787; font-variant-numeric:tabular-nums; min-width:44px; text-align:center}
  .deck-hint{font-size:10.4px; color:#9aa6b6; text-align:center; padding:0 0 10px; flex:none}
  .deck-hint kbd{font-family:inherit; font-size:9.8px; padding:1px 5px; border-radius:4px;
    border:1px solid #dbe4f1; background:#fff; color:#6b7787}

  @media (max-width:900px){
    .deck-stage{padding:10px 12px 2px}
    .slide{width:calc(100vw - 24px); height:calc(100vh - 150px); max-height:none; aspect-ratio:auto;
      overflow-y:auto; padding:18px 18px 16px; border-radius:6px}
    .sl-title{font-size:19px; letter-spacing:-.6px}
    .sl-org{font-size:9.4px}
    .sl-cards, .sl-links{grid-template-columns:1fr}
    .sl-links{display:none}
    .sl-cards{margin-top:12px; padding-top:6px; gap:10px}
    .sl-card{min-height:0}
    .sl-sum{margin-top:12px}
    .cv .cv-title{margin-top:64px; font-size:24px; letter-spacing:-1px}
    .deck-top{padding:9px 12px}
    .deck-top .dk-brand{font-size:9.8px}
    .deck-top .dk-close{font-size:10.2px; padding:0 9px; height:28px}
    .deck-progress{margin:7px 12px 0}
    .deck-nav{padding:9px 12px 7px; gap:8px}
    .dk-nav-btn{height:30px; padding:0 10px; font-size:10.8px}
    .deck-btn{padding:0 8px; font-size:10.5px}
    .deck-btn .dk-t{display:none}
    .notif-test{display:none}
  }
  /* === PRESENTATION_END (CSS) === */

